# For local dev, this points at a backend running on the same machine.
#
# IMPORTANT for production (running on the Omarchy server): this value is
# baked into the browser-side JS at `npm run build` time, and the fetch it
# drives runs in the *viewer's* browser (a phone, a laptop) — not on the
# server. So it must be an address the viewer's device can actually reach,
# never "localhost":
#   - Tailscale-only deploy: the backend's Tailscale IP or MagicDNS hostname
#   - Cloudflare Tunnel deploy (OMARCHY_SETUP.md Part K): the public origin,
#     e.g. https://lucy.tylersuits.com — the tunnel's ingress config routes
#     /auth, /chat, /upload, /history to the backend and everything else to
#     this frontend, so one origin covers both
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
