# For local dev, this points at a backend running on the same machine.
#
# IMPORTANT for production (running on the Omarchy server): this value is
# baked into the browser-side JS at `npm run build` time, and the fetch it
# drives runs in the *viewer's* browser (a phone, a laptop) — not on the
# server. So it must be the backend's Tailscale-reachable address (its
# Tailscale IP or MagicDNS hostname), never "localhost", or every device
# other than the server itself will fail to reach it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
