[Unit]
Description=Lucy backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__LUCY_USER__
WorkingDirectory=__LUCY_HOME__/Lucy/backend
EnvironmentFile=__LUCY_HOME__/Lucy/backend/.env
ExecStart=__LUCY_HOME__/Lucy/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
