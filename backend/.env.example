# Get a key at https://aistudio.google.com/apikey — enable billing on it
# (Settings -> Plan) rather than leaving it on the free tier. Free-tier
# content is used by Google to improve their products; paid-tier isn't.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CHROMA_PERSIST_DIR=./data/chroma
DATA_DIR=./data
DB_PATH=./data/lucy.db

# Random secret used to sign login JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
